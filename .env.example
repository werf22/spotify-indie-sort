# Create an app at https://developer.spotify.com/dashboard (or reuse the one
# already used by dj-set-spotify / spotify-tidal-sync — same Client ID/Secret
# work fine here, this tool only needs a refresh token, no new redirect URI).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Cloud-only BPM/key/energy/danceability/valence/mood enrichment.
# Free: 1,000 tracks/month. Starter: 150,000 tracks/month.
FREQBLOG_API_KEY=
FREQBLOG_ENABLED=0
FREQBLOG_MONTHLY_QUOTA=150000

# Local MP3/M4A/FLAC/OGG analysis. Separate multiple roots with ':' on macOS.
# When omitted, ~/Music and ~/Downloads are scanned automatically.
AUDIO_LIBRARY_ROOTS=/Users/your-name/Music:/Users/your-name/Downloads
# Optional paths that should never be traversed (':' separated).
AUDIO_LIBRARY_EXCLUDES=/Users/your-name/Music/Music
LOCAL_RHYTHM_BATCH=100
LOCAL_GENRE_BATCH=60
LOCAL_SEMANTIC_BATCH=40
# Keep disabled during cloud production to avoid sustained laptop heat.
LOCAL_AUDIO_ANALYSIS_ENABLED=0
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
MAEST_MODEL=mtg-upf/discogs-maest-10s-dw-75e
CLAP_MODEL=laion/larger_clap_music

# SoundNet Track Analysis on RapidAPI. Ultra is the only sensible 64k plan.
SOUNDNET_RAPIDAPI_KEY=
SOUNDNET_ENABLED=0

# Optional. Public key 123 is used when empty (30 requests/minute).
# A paid TheAudioDB key raises the limit and unlocks v2/MBID search.
THEAUDIODB_API_KEY=

# Required by MusicBrainz etiquette; public reads do not need OAuth.
MUSICBRAINZ_USER_AGENT=local-dj-music-db/1.0 (contact: your-email@example.com)

# Only needed to re-run classify.py later without a live Claude Code session.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Name of the playlist this tool maintains. Re-runs reuse the same playlist
# (id is cached in data/state.json) instead of creating duplicates.
TARGET_PLAYLIST_NAME=Indie Sort

# How many tracks to send to Claude per classification batch.
CLASSIFY_BATCH_SIZE=60

# Optional: personal Discogs token (discogs.com/settings/developers).
# Raises the OneTagger-bridge rate limit 25 -> 60 req/min and enables the
# structured track= search. Leave empty to keep the slower anonymous mode.
DISCOGS_TOKEN=
